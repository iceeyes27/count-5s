.page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f7efe3 0%, #e5c9ae 100%);
}

.control,
.data-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: transparent;
  border-radius: 0;
  line-height: 1;
}

.control::after,
.data-button::after {
  border: 0;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 4rpx 24rpx;
}

.eyebrow,
.title,
.description,
.phase-label,
.phase-name,
.countdown,
.phase-hint,
.section-title,
.summary-text,
.storage-note,
.empty-text,
.sound-note,
.history-status,
.timing-label,
.timing-value,
.timing-unit {
  display: block;
}

.eyebrow {
  color: #8e4b35;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #2f241f;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.description {
  margin-top: 12rpx;
  color: #6a554b;
  font-size: 28rpx;
  line-height: 1.45;
}

.mode-pill {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(137, 59, 38, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 249, 239, 0.84);
  color: #893b26;
  font-size: 24rpx;
  font-weight: 700;
}

.timer-card,
.mode-card,
.summary-card,
.history-card {
  border: 1rpx solid rgba(93, 58, 41, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 249, 239, 0.9);
  box-shadow: 0 18rpx 46rpx rgba(72, 41, 29, 0.14);
}

.timer-card {
  padding: 34rpx 28rpx;
  text-align: center;
}

.phase-label {
  color: #8e6a5b;
  font-size: 24rpx;
  font-weight: 700;
}

.phase-name {
  margin-top: 10rpx;
  color: #2f241f;
  font-size: 54rpx;
  font-weight: 800;
}

.countdown {
  margin-top: 12rpx;
  color: #c55c3d;
  font-size: 128rpx;
  font-weight: 900;
  line-height: 1;
}

.phase-hint {
  min-height: 44rpx;
  margin-top: 12rpx;
  color: #6a554b;
  font-size: 28rpx;
  line-height: 1.45;
}

.controls {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  width: 100%;
  overflow: hidden;
}

.control {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 80rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(137, 59, 38, 0.22);
  background: #fff8ef;
  color: #4a342b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.data-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  width: 100%;
  overflow: hidden;
}

.data-button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 72rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(137, 59, 38, 0.22);
  border-radius: 12rpx;
  background: #fff8ef;
  color: #4a342b;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.data-button.primary {
  border-color: #c55c3d;
  background: #c55c3d;
  color: #fffaf4;
}

.control.primary {
  border-color: #c55c3d;
  background: #c55c3d;
  color: #fffaf4;
}

.progress {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.56);
  text-align: left;
}

.progress-row,
.section-header,
.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-row {
  color: #5c463c;
  font-size: 26rpx;
}

.progress-strong {
  color: #2f241f;
  font-weight: 800;
}

.progress-track {
  height: 14rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(137, 59, 38, 0.12);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #c55c3d;
}

.progress-note {
  display: block;
  margin-top: 14rpx;
  color: #6a554b;
  font-size: 24rpx;
}

.mode-card,
.summary-card,
.history-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.section-title {
  color: #2f241f;
  font-size: 28rpx;
  font-weight: 800;
}

.sound-toggle {
  position: relative;
  flex: 0 0 auto;
  width: 88rpx;
  height: 52rpx;
  border: 2rpx solid rgba(137, 59, 38, 0.18);
  border-radius: 999rpx;
  background: #f4e4d4;
  box-shadow: inset 0 2rpx 6rpx rgba(72, 41, 29, 0.1);
  transition: background 120ms ease, border-color 120ms ease;
}

.sound-toggle.active {
  border-color: #c55c3d;
  background: #c55c3d;
}

.sound-toggle-dot {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #fffaf4;
  box-shadow: 0 4rpx 12rpx rgba(72, 41, 29, 0.22);
  transition: transform 120ms ease;
}

.sound-toggle.active .sound-toggle-dot {
  transform: translateX(36rpx);
}

.timing-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.timing-picker {
  display: block;
}

.timing-picker-inner {
  min-height: 120rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(137, 59, 38, 0.18);
  border-radius: 14rpx;
  background: #fff8ef;
}

.timing-label {
  color: #7a6257;
  font-size: 24rpx;
}

.timing-value-group {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 14rpx;
}

.timing-value {
  color: #2f241f;
  font-size: 56rpx;
  font-weight: 850;
  line-height: 1;
}

.timing-unit {
  color: #8e6a5b;
  font-size: 24rpx;
  font-weight: 700;
}

.sound-note,
.storage-note,
.empty-text {
  margin-top: 16rpx;
  color: #7a6257;
  font-size: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-box {
  min-height: 132rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(93, 58, 41, 0.14);
  border-radius: 14rpx;
  background: rgba(255, 249, 239, 0.9);
}

.stat-title {
  display: block;
  color: #7a6257;
  font-size: 24rpx;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  color: #2f241f;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.15;
}

.summary-text {
  margin-top: 12rpx;
  color: #5c463c;
  font-size: 26rpx;
  line-height: 1.5;
}

.history-list {
  margin-top: 14rpx;
}

.history-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(93, 58, 41, 0.12);
  color: #4a342b;
  font-size: 26rpx;
}

.history-meta {
  flex: 0 0 auto;
  text-align: right;
}

.history-status {
  margin-top: 6rpx;
  color: #7a6257;
  font-size: 22rpx;
}

.history-row:last-child {
  border-bottom: 0;
}
